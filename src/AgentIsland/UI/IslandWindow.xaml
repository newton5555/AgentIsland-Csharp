<Window x:Class="AgentIsland.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AgentIsland.UI"
        Title="Agent Island"
        Width="900" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="RootHost">
        <!-- Rotating comet ring hugging the island edge (LoadingSweep on
             macOS). Sized +4 over the silhouette so half the 4px stroke
             peeks outside; the opaque silhouette covers the inner half. -->
        <Border x:Name="Sweep"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Width="280"
                Height="38"
                Margin="0,-2,0,0"
                CornerRadius="0,0,16,16"
                BorderThickness="4"
                IsHitTestVisible="False">
            <Border.Effect>
                <!-- macOS feathers the comet by blurring the stroke mask.
                     The gaussian re-runs on every 15fps sweep step, so the
                     kernel stays small and the bias fast: radius 5 at
                     Performance costs ~3% of a core and still melts the
                     stroke's hard rim (9/Quality read better but billed
                     8%). -->
                <BlurEffect Radius="5" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>
        <Border x:Name="Silhouette"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Width="276"
                Height="36"
                CornerRadius="0,0,14,14"
                Background="#020203"
                MouseEnter="OnSilhouetteMouseEnter"
                MouseLeave="OnSilhouetteMouseLeave"
                MouseLeftButtonUp="OnSilhouetteClick">
            <Border.Effect>
                <!-- SwiftUI shadow(radius:) is a gaussian sigma; WPF BlurRadius
                     is the kernel extent (~3x). The macOS radius-14 aura needs
                     ~42 here or it renders as a hard rim, not a glow. -->
                <DropShadowEffect x:Name="Halo" ShadowDepth="0" BlurRadius="42" Opacity="0.35" Color="#000000" RenderingBias="Quality"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <!-- Bar strip on top, expanded panel growing downward. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top strip, macOS structure: the logo tabs flank the notch
                     CENTER; peek pills grow OUTBOARD of them (the side
                     columns animate 0 -> 104); in expanded the side columns
                     collapse so the logos glide out to the panel corners. -->
                <Grid x:Name="TopStrip" Grid.Row="0">
                    <!-- The star center column is never animated directly:
                         it absorbs whatever the silhouette width leaves over
                         (the notch gap; zero in solo-centered mode). -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftPillColumn" Width="0"/>
                        <ColumnDefinition x:Name="LeftTabColumn" Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="RightTabColumn" Width="38"/>
                        <ColumnDefinition x:Name="RightPillColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <!-- Pills anchor to the OUTER edges (14pt inset), leaving
                         air between pill and logo — the macOS bar spacing. -->
                    <ui:NotchPeekPill x:Name="LeftPill" Grid.Column="0"
                                      HorizontalAlignment="Left" Margin="14,0,6,0" Opacity="0"/>
                    <ui:ProviderLogo x:Name="LeftLogo" Grid.Column="1"/>
                    <ui:ProviderLogo x:Name="RightLogo" Grid.Column="3"/>
                    <ui:NotchPeekPill x:Name="RightPill" Grid.Column="4"
                                      HorizontalAlignment="Right" Margin="6,0,14,0" Opacity="0"/>
                </Grid>

                <!-- Expanded panel: swipeable pages over a fixed footer. -->
                <Grid x:Name="ExpandedContent" Grid.Row="1" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ContentSlide" Y="-8"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                </Grid>

                <!-- Settings gear, bottom-left of the expanded panel. -->
                <TextBlock x:Name="SettingsGear"
                           Grid.Row="1"
                           Text="&#xE713;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="#73FFFFFF"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="12,0,0,11"
                           Opacity="0"
                           Visibility="Collapsed"
                           Cursor="Hand"
                           MouseLeftButtonUp="OnSettingsGearClick"
                           MouseEnter="OnSettingsGearEnter"
                           MouseLeave="OnSettingsGearLeave"/>
            </Grid>
        </Border>
    </Grid>
</Window>
