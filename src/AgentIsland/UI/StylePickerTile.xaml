<UserControl x:Class="AgentIsland.UI.StylePickerTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="Black"
             xmlns:charts="clr-namespace:AgentIsland.UI.Charts">
    <Border x:Name="TileBorder"
            Height="100"
            CornerRadius="9"
            Background="#06FFFFFF"
            BorderThickness="1"
            BorderBrush="Transparent"
            Margin="0,0,6,0"
            Cursor="Hand">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Grid x:Name="PreviewHost"
                  Height="40"
                  Margin="0,0,0,10">
                <ContentPresenter x:Name="PreviewSlot" />
            </Grid>
            <TextBlock x:Name="TileLabel"
                       FontFamily="{x:Static charts:IslandFonts.Ui}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#8CFFFFFF"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
