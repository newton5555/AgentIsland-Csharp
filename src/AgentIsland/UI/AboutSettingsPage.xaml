<UserControl x:Class="AgentIsland.UI.AboutSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="Black"
             xmlns:charts="clr-namespace:AgentIsland.UI.Charts">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid MinHeight="395" ClipToBounds="True">
        <!-- Ghost Brand Mark -->
        <Image Source="pack://application:,,,/Assets/agentisland_logo.png"
               Width="205" Opacity="0.07"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-30,-60"
               RenderTransformOrigin="0.5,0.5"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <RotateTransform Angle="-9" />
            </Image.RenderTransform>
            <Image.Effect>
                <BlurEffect Radius="2.5" />
            </Image.Effect>
        </Image>

        <!-- Main Content -->
        <StackPanel Margin="24,20,24,20">
            <!-- App Name -->
            <TextBlock Text="Agent Island"
                       FontFamily="{x:Static charts:IslandFonts.Ui}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#F2FFFFFF"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="SubtitleText"
                       FontFamily="{x:Static charts:IslandFonts.Ui}"
                       FontSize="12"
                       Foreground="#66FFFFFF"
                       Margin="0,0,0,24" />

            <!-- Divider -->
            <Border Height="0.5" Background="#18FFFFFF" Margin="0,0,0,20" />

            <!-- Source & Repository Links -->
            <StackPanel>
                <!-- 1. This Repo (Fork) -->
                <Border x:Name="ForkRepoRow" CornerRadius="8" Padding="12,10,12,10" Background="#08FFFFFF" Cursor="Hand" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ForkRepoLabel"
                                   FontFamily="{x:Static charts:IslandFonts.Ui}" FontSize="12"
                                   Foreground="#9EFFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="https://github.com/newton5555/AgentIsland-Csharp" Grid.Column="1"
                                   FontFamily="{x:Static charts:IslandFonts.Ui}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#42A5F5" VerticalAlignment="Center" />
                        <TextBlock Text=" &#xE8A7;" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                   FontSize="9" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Border>

                <!-- 2. Upstream Project (Agent Island macOS) -->
                <Border x:Name="UpstreamRepoRow" CornerRadius="8" Padding="12,10,12,10" Background="#08FFFFFF" Cursor="Hand" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpstreamRepoLabel"
                                   FontFamily="{x:Static charts:IslandFonts.Ui}" FontSize="12"
                                   Foreground="#9EFFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="https://github.com/tristan666666/agent-island" Grid.Column="1"
                                   FontFamily="{x:Static charts:IslandFonts.Ui}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text=" &#xE8A7;" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                   FontSize="9" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Border>

                <!-- 3. Reference Project (Codex Island) -->
                <Border x:Name="InspirationRepoRow" CornerRadius="8" Padding="12,10,12,10" Background="#08FFFFFF" Cursor="Hand" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InspirationRepoLabel"
                                   FontFamily="{x:Static charts:IslandFonts.Ui}" FontSize="12"
                                   Foreground="#9EFFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="https://github.com/ericjypark/codex-island" Grid.Column="1"
                                   FontFamily="{x:Static charts:IslandFonts.Ui}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text=" &#xE8A7;" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                   FontSize="9" Foreground="#55FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
