<UserControl x:Class="AgentIsland.UI.AlertsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="Black"
             xmlns:ui="clr-namespace:AgentIsland.UI"
             xmlns:charts="clr-namespace:AgentIsland.UI.Charts">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="14,18,14,6">
        <!-- Approaching-limit alerts Toggle -->
        <ui:SettingsRowControl Title="Approaching-limit alerts">
            <ui:CobaltToggle x:Name="AlertsToggle" />
        </ui:SettingsRowControl>

        <!-- Threshold rows container -->
        <StackPanel x:Name="AlertsHost" Margin="10,8,10,8">
            <!-- Warning Threshold -->
            <Grid Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#F5A524"
                         VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="#F5A524" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock Grid.Column="1" x:Name="WarningLabelBlock"
                           FontFamily="{x:Static charts:IslandFonts.Ui}"
                           FontSize="13" FontWeight="Medium"
                           Foreground="#EBFFFFFF" VerticalAlignment="Center" />

                <Border Grid.Column="2" CornerRadius="7" Background="#0DFFFFFF"
                        BorderBrush="#1AFFFFFF" BorderThickness="0.5" Width="64" Height="28">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox x:Name="WarningField" Width="26"
                                 FontFamily="{x:Static charts:IslandFonts.Mono}"
                                 FontSize="11" FontWeight="SemiBold"
                                 Foreground="#F2FFFFFF" Background="Transparent"
                                 BorderThickness="0" TextAlignment="Center"
                                 VerticalAlignment="Center" CaretBrush="White" />
                        <TextBlock Text="%" FontFamily="{x:Static charts:IslandFonts.Mono}"
                                   FontSize="11" Foreground="#8CFFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Critical Threshold -->
            <Grid Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#E5484D"
                         VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="#E5484D" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock Grid.Column="1" x:Name="CriticalLabelBlock"
                           FontFamily="{x:Static charts:IslandFonts.Ui}"
                           FontSize="13" FontWeight="Medium"
                           Foreground="#EBFFFFFF" VerticalAlignment="Center" />

                <Border Grid.Column="2" CornerRadius="7" Background="#0DFFFFFF"
                        BorderBrush="#1AFFFFFF" BorderThickness="0.5" Width="64" Height="28">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox x:Name="CriticalField" Width="26"
                                 FontFamily="{x:Static charts:IslandFonts.Mono}"
                                 FontSize="11" FontWeight="SemiBold"
                                 Foreground="#F2FFFFFF" Background="Transparent"
                                 BorderThickness="0" TextAlignment="Center"
                                 VerticalAlignment="Center" CaretBrush="White" />
                        <TextBlock Text="%" FontFamily="{x:Static charts:IslandFonts.Mono}"
                                   FontSize="11" Foreground="#8CFFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
