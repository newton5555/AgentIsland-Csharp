<UserControl x:Class="AgentIsland.UI.DisplaySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="Black"
             xmlns:ui="clr-namespace:AgentIsland.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="14,18,14,6">
        <!-- Usage display header -->
        <Grid Margin="10,14,10,6">
            <TextBlock Text="{x:Static ui:DisplaySettingsPage.UsageDisplayLabel}"
                       Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0" />
        </Grid>

        <!-- Chart Style Picker -->
        <ui:ChartStylePickerControl x:Name="StylePicker" Margin="10,2,2,8" />

        <!-- Quota shows -->
        <ui:SettingsRowControl Title="Quota shows">
            <ui:Segmented x:Name="QuotaSeg" />
        </ui:SettingsRowControl>

        <!-- Cost display header with toggle -->
        <Grid Margin="10,14,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static ui:DisplaySettingsPage.CostDisplayLabel}"
                       Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0" />
            <ui:CobaltToggle Grid.Column="1" x:Name="CostToggle" />
        </Grid>

        <!-- Cost Style Picker Host -->
        <ContentControl x:Name="CostPickerHost" Margin="10,2,2,8" />

        <!-- Top bar section -->
        <TextBlock Text="{x:Static ui:DisplaySettingsPage.TopBarLabel}"
                   Style="{StaticResource SettingsSectionHeaderStyle}" />

        <!-- Visual mode -->
        <ui:SettingsRowControl Title="Visual mode">
            <ComboBox x:Name="VisualModeCombo" Width="130"
                      Style="{StaticResource DarkComboBoxStyle}"
                      VerticalAlignment="Center" />
        </ui:SettingsRowControl>

        <!-- Glow color (visible only under Vivid) -->
        <ui:SettingsRowControl x:Name="GlowColorRow" Title="Glow color" />

        <!-- Interface scale -->
        <ui:SettingsRowControl Title="Interface scale">
            <ComboBox x:Name="ScaleBox" Width="90"
                      Style="{StaticResource DarkComboBoxStyle}"
                      VerticalAlignment="Center" />
        </ui:SettingsRowControl>

        <!-- Always show usage in top bar -->
        <ui:SettingsRowControl Title="Always show usage in top bar">
            <ui:CobaltToggle x:Name="AlwaysShowToggle" />
        </ui:SettingsRowControl>

        <!-- Screen section -->
        <TextBlock Text="{x:Static ui:DisplaySettingsPage.ScreenLabel}"
                   Style="{StaticResource SettingsSectionHeaderStyle}" />

        <!-- Show on -->
        <ui:SettingsRowControl x:Name="ShowOnRow" Title="Show on">
            <ComboBox x:Name="DisplayCombo" Width="180"
                      Style="{StaticResource DarkComboBoxStyle}"
                      VerticalAlignment="Center" />
        </ui:SettingsRowControl>

        <!-- Position section -->
        <TextBlock Text="{x:Static ui:DisplaySettingsPage.PositionLabel}"
                   Style="{StaticResource SettingsSectionHeaderStyle}" />

        <!-- Island position -->
        <ui:SettingsRowControl Title="Island position"
                               Subtitle="A bar at the top of the screen, or a floating widget you drag anywhere.">
            <ComboBox x:Name="PlacementBox" Width="180"
                      Style="{StaticResource DarkComboBoxStyle}"
                      VerticalAlignment="Center" />
        </ui:SettingsRowControl>
    </StackPanel>
</UserControl>
