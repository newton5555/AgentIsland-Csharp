<UserControl x:Class="AgentIsland.UI.PillButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="Black"
             xmlns:charts="clr-namespace:AgentIsland.UI.Charts"
             VerticalAlignment="Center">
    <Border x:Name="RootBorder"
            CornerRadius="6"
            Background="#1AFFFFFF"
            BorderBrush="#14FFFFFF"
            BorderThickness="0.5"
            Padding="12,5,12,5"
            Cursor="Hand"
            VerticalAlignment="Center">
        <TextBlock x:Name="LabelBlock"
                   FontFamily="{x:Static charts:IslandFonts.Ui}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#E6FFFFFF" />
    </Border>
</UserControl>
