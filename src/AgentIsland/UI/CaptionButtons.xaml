<UserControl x:Class="AgentIsland.UI.CaptionButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="Black"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             HorizontalAlignment="Right"
             VerticalAlignment="Top">
    <StackPanel Orientation="Horizontal">
        <!-- Minimize -->
        <Border x:Name="MinButton" Width="38" Height="28" Background="Transparent" Cursor="Hand"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="MinText"
                       Text="&#xE921;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="9.5"
                       Foreground="#8CFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Maximize / Restore -->
        <Border x:Name="MaxButton" Width="38" Height="28" Background="Transparent" Cursor="Hand"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="MaxText"
                       Text="&#xE922;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="9.5"
                       Foreground="#8CFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Close -->
        <Border x:Name="CloseButton" Width="38" Height="28" Background="Transparent" Cursor="Hand"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="CloseText"
                       Text="&#xE8BB;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="9.5"
                       Foreground="#8CFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
