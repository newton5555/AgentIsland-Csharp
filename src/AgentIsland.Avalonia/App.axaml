<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:AgentIsland.Avalonia.Converters"
             x:Class="AgentIsland.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AgentIsland.Avalonia/Styles/IslandColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ColorKeyToBrushConverter x:Key="ColorKeyToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AgentIsland.Avalonia/Styles/IslandStyles.axaml" />
    </Application.Styles>
</Application>
